{
  "pipeline_version": "1.0.0",
  "input": "../FollowMe_august_2025",
  "output": "data/private/followme",
  "secret_file": "data/private/followme.secret",
  "secret_env": "FOLLOWME_HMAC_SECRET",
  "chunk_rows": 100000,
  "duckdb_memory_limit": "1GB",
  "duckdb_threads": 1,
  "timestamp_formats": ["%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M:%S.%f", "%Y-%m-%dT%H:%M:%S", "%Y-%m-%dT%H:%M:%S.%f"],
  "source_timezone": null,
  "timestamp_semantics_compatible": false,
  "speed_unit": null,
  "heading_convention": null,
  "review_extent": {"min_latitude": -2, "max_latitude": 9, "min_longitude": 70, "max_longitude": 76},
  "large_reporting_lag_seconds": 3600,
  "gap_seconds": 900,
  "candidate_gap_seconds": [300, 900, 1800],
  "extreme_speed_kmh": 200,
  "isolated_jump_return_metres": 500,
  "standstill_metres": 10,
  "speed_disagreement_kmh": 30,
  "suspicious_cluster_min_observations": 1000,
  "suspicious_cluster_min_devices": 5,
  "sparse_min_observations": 10,
  "sparse_min_span_seconds": 600,
  "sparse_max_median_gap_seconds": 900,
  "max_archive_uncompressed_bytes": 20000000000,
  "max_archive_members": 10000,
  "region_geometry": null,
  "gap_selection_rationale": "Provisional 15-minute continuity rule; inspect per-device/day sampling and compare 5/15/30-minute sensitivity. Unknown sampling policy prevents a validated continuity threshold. Never join separate collection dates."
}
